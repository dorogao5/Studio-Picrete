{
  "calculator": {
    "description": "34-digit Decimal arithmetic using numeric literals and allowed operations/functions only: + - * / ^ including fractional powers; unary ln/log (natural), exp, sqrt. No symbols, assignments or equations. Units are not inferred: result unit is null and unit_inference is not_performed. Convert and verify physical units explicitly.",
    "parameters": {
      "type": "object",
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  },
  "sympy": {
    "description": "AST-whitelisted real-symbol algebra. Declare all symbols including variable. Constants pi/E; unary ln/log/exp/sqrt/sin/cos/tan/asin/acos/atan/sinh/cosh/tanh/abs. Solve expression=0 without '=' syntax. Identity false means NOT PROVEN, never automatic inequivalence/grading failure; review domains separately.",
    "parameters": {
      "type": "object",
      "required": [
        "operation",
        "symbols"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "simplify",
            "derivative",
            "integral",
            "solve",
            "identity"
          ]
        },
        "expression": {
          "type": "string",
          "maxLength": 512
        },
        "equation": {
          "type": "string",
          "maxLength": 512
        },
        "left": {
          "type": "string",
          "maxLength": 512
        },
        "right": {
          "type": "string",
          "maxLength": 512
        },
        "variable": {
          "type": "string",
          "maxLength": 64
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "reference_db": {
    "description": "Search verified stored reference records by chemical formula/name and property. Start with query; never invent reference_id. Returns values, units, phases, conditions, sources and actual IDs. unique gives record; ambiguous gives candidates to refine; not_found means no stored data; conditions_unverified must not be treated as an exact condition match. No external web retrieval or invented values.",
    "parameters": {
      "type": "object",
      "required": [],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Substance formula (preferred; case sensitive: CO differs from Co), chemical name in Russian/English, or a half-reaction. Examples: AgCl; H2O; [Cu(NH3)4]2+; gas constant. No private index is needed."
        },
        "property": {
          "type": "string",
          "enum": [
            "solubility_product",
            "standard_molar_formation_enthalpy",
            "standard_molar_entropy",
            "standard_molar_heat_capacity_pressure",
            "acid_dissociation_constant",
            "base_dissociation_constant",
            "complex_instability_constant",
            "standard_electrode_potential",
            "molar_gas_constant",
            "avogadro_number",
            "relative_atomic_mass",
            "molar_mass",
            "atomic_number",
            "electron_configuration",
            "mean_bond_energy",
            "diatomic_dissociation_energy",
            "cryoscopic_constant",
            "ebullioscopic_constant",
            "limiting_ionic_mobility",
            "van_der_waals_a",
            "van_der_waals_b",
            "calorie_to_joule",
            "atmosphere_to_pascal",
            "torr_to_pascal",
            "molar_energy_per_wavenumber",
            "electrode_potential_at_specified_concentration"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "solid",
            "liquid",
            "gas",
            "aqueous"
          ],
          "description": "Required material phase when known; unknown phase is reported, not assumed."
        },
        "temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "description": "Optional exact temperature in kelvin. Missing source temperature is reported as unverified; values at other temperatures are excluded."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "reference_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Exact ID returned by search. Use alone. Known legacy IDs remain supported; returned units are authoritative."
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "query"
          ],
          "not": {
            "required": [
              "reference_id"
            ]
          }
        },
        {
          "required": [
            "reference_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "property"
                ]
              },
              {
                "required": [
                  "phase"
                ]
              },
              {
                "required": [
                  "temperature_k"
                ]
              },
              {
                "required": [
                  "limit"
                ]
              },
              {
                "required": [
                  "offset"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
